<configuration debug="false">

    <!-- stdout appender -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d (%t) [%24F:%-3L:%-5p]%X %m%n</pattern>
        </encoder>
    </appender>

    <!-- ofbiz file appender -->
    <appender name="OFBIZ_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>../../../runtime/logs/ofbiz.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>../../../runtime/logs/ofbiz.%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>10</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d (%t) [%24F:%-3L:%-5p]%X %m%n</pattern>
        </encoder>
    </appender>

    <!-- ofbiz web/html file appender -->
    <appender name="OFBIZ_HTML" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>../../../runtime/logs/ofbiz.html</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>../../../runtime/logs/ofbiz.%i.html</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>1</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>500KB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>&lt;div class="%p"&gt;%d (%t) [%24F:%-3L:%-5p]%X %m &lt;/div&gt;%n</pattern>
        </encoder>
    </appender>

    <!-- debug log -->
    <appender name="DEBUG_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>../../../runtime/logs/debug.log</file>
        <append>false</append>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>DEBUG</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>TRACE</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>NEUTRAL</onMismatch>
        </filter>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>INFO</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>../../../runtime/logs/debug.%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>10</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d (%t) [%24F:%-3L:%-5p]%X %m%n</pattern>
        </encoder>
    </appender>

    <!-- error log -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>../../../runtime/logs/error.log</file>
        <append>false</append>
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <onMatch>ACCEPT</onMatch>
            <onMismatch>DENY</onMismatch>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>../../../runtime/logs/error.%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>10</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>10MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d (%t) [%24F:%-3L:%-5p]%X %m%n</pattern>
        </encoder>
    </appender>

    <!-- special minerva log -->
    <appender name="MINERVA_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>../../../runtime/logs/minerva.log</file>
        <append>false</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>../../../runtime/logs/minerva.%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>10</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>5MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d (%t) [%24F:%-3L:%-5p]%X %m%n</pattern>
        </encoder>
    </appender>

    <!-- special fop log -->
    <appender name="FOP_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>../../../runtime/logs/fop.log</file>
        <append>false</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.FixedWindowRollingPolicy">
            <fileNamePattern>../../../runtime/logs/fop.%i.log</fileNamePattern>
            <minIndex>1</minIndex>
            <maxIndex>10</maxIndex>
        </rollingPolicy>
        <triggeringPolicy class="ch.qos.logback.core.rolling.SizeBasedTriggeringPolicy">
            <maxFileSize>5MB</maxFileSize>
        </triggeringPolicy>
        <encoder>
            <pattern>%d (%t) [%24F:%-3L:%-5p]%X %m%n</pattern>
        </encoder>
    </appender>

    <!-- async appender wrapping all the above -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <includeCallerData>true</includeCallerData>
        <queueSize>256</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <appender-ref ref="STDOUT" />
        <appender-ref ref="OFBIZ_FILE" />
        <appender-ref ref="OFBIZ_HTML" />
        <appender-ref ref="DEBUG_FILE" />
        <appender-ref ref="ERROR_FILE" />
    </appender>

    <!-- Logger configurations -->
    <logger name="org.ofbiz.base.converter.Converters" level="WARN"/>
    <logger name="org.apache.axis" level="WARN"/>
    <logger name="org.apache.catalina" level="WARN"/>
    <logger name="org.apache.commons.digester" level="WARN"/>
    
    <!-- geronimo transaction logging -->
    <logger name="org.apache.geronimo.transaction" level="WARN">
        <appender-ref ref="MINERVA_LOG"/>
    </logger>

    <!-- fop rendering logging -->
    <logger name="org.apache.fop" level="INFO">
        <appender-ref ref="FOP_LOG"/>
    </logger>

    <!-- root logger -->
    <root level="ALL">
        <appender-ref ref="ASYNC"/>
    </root>

</configuration>

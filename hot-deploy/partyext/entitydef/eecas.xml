<entity-eca xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/entity-eca.xsd">
	<!-- validazione per ilc ontrollo delle date inserire -->
    <eca entity="PartyHistory" operation="create" event="validate">
        <action service="validateDatePartyHistory" mode="sync" abort-on-error="true" rollback-on-error="true"/>
    </eca>

    <!-- Derivazione automatica del profilo referente (Performance Strategica CTX_BS) - MODEL B (unico modello):
         il referente e' per-misura su WorkEffortMeasure.partyId (per scheda/UO), roleTypeId='WEM_IND_IN_CHARGE'.
         Quando una misura riceve/aggiorna il referente, la PERSONA (wem.partyId) entra in STRATPERF_REFERENTE =>
         permesso CONSUNT_CTX_BS_VIEW => menu "Consuntivazione indicatori". Best-effort e idempotente.
         NB: rimosso l'ECA Model A su GlAccountRole (referente sul catalogo, abbandonato): il referente non sta
         piu' sul catalogo ma solo sulla misura. Vedi doc 05/10. -->
    <eca entity="WorkEffortMeasure" operation="create-store" event="return">
        <condition field-name="roleTypeId" operator="equals" value="WEM_IND_IN_CHARGE"/>
        <action service="deriveReferenteGroupOnIndInCharge" mode="sync" abort-on-error="false" rollback-on-error="false"/>
    </eca>

</entity-eca>

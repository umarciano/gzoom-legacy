<service-eca xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://ofbiz.apache.org/dtds/service-eca.xsd">
        
        <eca service="crudServiceOperation_WorkEffort" event="invoke">
            <condition field-name="operation" operator="equals" value="UPDATE"/>
            <action mode="sync" service="crudServiceOperation_saveOldWorkEffortEstimatedStartAndCompletionDate"/>
        </eca>
        
        <eca service="crudServiceOperation_WorkEffort" event="commit">
            <condition field-name="operation" operator="equals" value="UPDATE"/>
            <action mode="sync" service="crudServiceDefaultOrchestration_updateByWorkEffortEstimatedStartAndCompletionDate" ignore-error="false" ignore-failure="false"/>
        </eca>
        
        <!-- ToDo 3820 punto 2 -->
        <eca service="crudServiceDefaultOrchestration_WorkEffortRootStatus" event="commit">
            <action mode="sync" service="crudServiceDefaultOrchestration_updateWorkEffortIsPostedFlag" ignore-error="false" ignore-failure="false"/>
        </eca>
        
        <eca service="crudServiceDefaultOrchestration_WorkEffortRootView" event="commit">
            <condition operator="equals" field-name="operation" value="CREATE"/>
            <action mode="sync" service="createJbpmProcess" ignore-error="false" ignore-failure="false"/>
        </eca>
        
        <eca service="crudServiceDefaultOrchestration_WorkEffort" event="commit">
            <condition operator="equals" field-name="operation" value="CREATE"/>
            <action mode="sync" service="createJbpmProcess" ignore-error="false" ignore-failure="false"/>
        </eca>

        <!-- Doppio ciclo CTX_BS: dopo il salvataggio di un valore intermedio (ACTUAL_INT),
             se tutti gli indicatori parzialmente consuntivabili della scheda hanno lo score
             intermedio, avanza da WEORCARD_TOACC_INT a WEORCARD_ACC_INT.
             event="return" -> stessa transazione: errore rollbacca anche il valore. -->
        <eca service="saveIndicatorConsuntivo" event="return">
            <condition field-name="glFiscalTypeId" operator="equals" value="ACTUAL_INT"/>
            <action mode="sync" service="checkCardCompleteAndAdvance" ignore-error="false" ignore-failure="false"/>
        </eca>
</service-eca>        
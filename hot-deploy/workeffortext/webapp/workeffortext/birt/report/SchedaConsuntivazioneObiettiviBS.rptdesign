        </table>
        <table id="600">
            <property name="width">100%</property>
            <property name="repeatHeader">false</property>
            <property name="dataSet">ConsuntivoDS</property>
            <list-property name="boundDataColumns">
                <structure><property name="name">cod</property><expression name="expression" type="javascript">dataSetRow["cod"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">indicatore</property><expression name="expression" type="javascript">dataSetRow["indicatore"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">formula</property><expression name="expression" type="javascript">dataSetRow["formula"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">peso</property><expression name="expression" type="javascript">dataSetRow["peso"]</expression><property name="dataType">decimal</property></structure>
                <structure><property name="name">fonte</property><expression name="expression" type="javascript">dataSetRow["fonte"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">referente</property><expression name="expression" type="javascript">dataSetRow["referente"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">range_verbale</property><expression name="expression" type="javascript">dataSetRow["range_verbale"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">numeratore</property><expression name="expression" type="javascript">dataSetRow["numeratore"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">denominatore</property><expression name="expression" type="javascript">dataSetRow["denominatore"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">risultato</property><expression name="expression" type="javascript">dataSetRow["risultato"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">punti_conseguiti</property><expression name="expression" type="javascript">dataSetRow["punti_conseguiti"]</expression><property name="dataType">decimal</property></structure>
                <structure>
                    <property name="name">totPeso</property>
                    <property name="dataType">decimal</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure><property name="name">Expression</property><expression name="value" type="javascript">dataSetRow["peso"]</expression></structure>
                    </list-property>
                </structure>
                <structure>
                    <property name="name">totPunti</property>
                    <property name="dataType">decimal</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure><property name="name">Expression</property><expression name="value" type="javascript">(dataSetRow["punti_conseguiti"]==null?0:dataSetRow["punti_conseguiti"])</expression></structure>
                    </list-property>
                </structure>
            </list-property>
            <column id="601"><property name="width">0.5in</property></column>
            <column id="602"><property name="width">1.7in</property></column>
            <column id="603"><property name="width">1.4in</property></column>
            <column id="604"><property name="width">0.5in</property></column>
            <column id="605"><property name="width">0.9in</property></column>
            <column id="606"><property name="width">1.1in</property></column>
            <column id="607"><property name="width">1.4in</property></column>
            <column id="608"><property name="width">0.7in</property></column>
            <column id="609"><property name="width">0.7in</property></column>
            <column id="610"><property name="width">0.75in</property></column>
            <column id="611"><property name="width">0.75in</property></column>
            <header>
                <row id="620">
                    <cell id="6201"><property name="style">celhdr</property><label id="6301"><text-property name="text">Cod.</text-property></label></cell>
                    <cell id="6202"><property name="style">celhdr</property><label id="6302"><text-property name="text">Indicatore</text-property></label></cell>
                    <cell id="6203"><property name="style">celhdr</property><label id="6303"><text-property name="text">Formula</text-property></label></cell>

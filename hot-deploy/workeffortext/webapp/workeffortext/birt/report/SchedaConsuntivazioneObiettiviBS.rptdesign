<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="createdBy">GZoom Cardarelli - Performance Strategica</property>
    <property name="units">in</property>
    <property name="theme">base_structure_JDBC.Base</property>
    <property name="iconFile">/templates/blank_report.gif</property>
    <property name="layoutPreference">auto layout</property>
    <property name="bidiLayoutOrientation">ltr</property>
    <!-- SCHEDA 3 - CONSUNTIVAZIONE (Raccolta_Requisiti 8.2). Template layout pronto.
         NB: le colonne consuntivo (Numeratore/Denominatore/Risultato/Punti conseguiti) sono al momento
         PLACEHOLDER (NULL) in ConsuntivoDS: verranno collegate ai movimenti AcctgTrans (ACTUAL, PAR_*, SCORE)
         quando il modello di salvataggio della modale referente sara' confermato (doc 13 §3.1). -->
    <list-property name="libraries">
        <structure>
            <property name="fileName">hot-deploy/base/webapp/resources/report/birt/base_structure_JDBC.rptlibrary</property>
            <property name="namespace">base_structure_JDBC</property>
        </structure>
        <structure>
            <property name="fileName">hot-deploy/workeffortext/webapp/workeffortext/birt/report/LibreriaSchedeStruttura.rptlibrary</property>
            <property name="namespace">LibreriaSchedeStruttura</property>
        </structure>
    </list-property>
    <parameters>
        <scalar-parameter name="userLoginId" id="188" extends="base_structure_JDBC.userLoginId"/>
        <scalar-parameter name="defaultOrganizationPartyId" id="208" extends="base_structure_JDBC.defaultOrganizationPartyId"/>
        <scalar-parameter name="workEffortId" id="463" extends="LibreriaSchedeStruttura.workEffortId"/>
        <scalar-parameter name="workEffortIdChild" id="464" extends="LibreriaSchedeStruttura.workEffortIdChild"/>
        <scalar-parameter name="partyId" id="465" extends="LibreriaSchedeStruttura.partyId"/>
        <scalar-parameter name="roleTypeId" id="466" extends="LibreriaSchedeStruttura.roleTypeId"/>
        <scalar-parameter name="orgUnitId" id="467" extends="LibreriaSchedeStruttura.orgUnitId"/>
        <scalar-parameter name="orgUnitRoleTypeId" id="468" extends="LibreriaSchedeStruttura.orgUnitRoleTypeId"/>
    </parameters>
    <data-sources>
        <oda-data-source extensionID="org.eclipse.birt.report.data.oda.jdbc" name="GeneralDataSource" id="900" extends="base_structure_JDBC.GeneralDataSource"/>
    </data-sources>
    <data-sets>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="ConsuntivoDS" id="910">
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="paramName">workEffortId</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure><property name="position">1</property><property name="name">cod</property><property name="nativeName">cod</property><property name="dataType">string</property></structure>
                <structure><property name="position">2</property><property name="name">indicatore</property><property name="nativeName">indicatore</property><property name="dataType">string</property></structure>
                <structure><property name="position">3</property><property name="name">formula</property><property name="nativeName">formula</property><property name="dataType">string</property></structure>
                <structure><property name="position">4</property><property name="name">peso</property><property name="nativeName">peso</property><property name="dataType">decimal</property></structure>
                <structure><property name="position">5</property><property name="name">fonte</property><property name="nativeName">fonte</property><property name="dataType">string</property></structure>
                <structure><property name="position">6</property><property name="name">referente</property><property name="nativeName">referente</property><property name="dataType">string</property></structure>
                <structure><property name="position">7</property><property name="name">range_verbale</property><property name="nativeName">range_verbale</property><property name="dataType">string</property></structure>
                <structure><property name="position">8</property><property name="name">numeratore</property><property name="nativeName">numeratore</property><property name="dataType">string</property></structure>
                <structure><property name="position">9</property><property name="name">denominatore</property><property name="nativeName">denominatore</property><property name="dataType">string</property></structure>
                <structure><property name="position">10</property><property name="name">risultato</property><property name="nativeName">risultato</property><property name="dataType">string</property></structure>
                <structure><property name="position">11</property><property name="name">punti_conseguiti</property><property name="nativeName">punti_conseguiti</property><property name="dataType">decimal</property></structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  gl.account_code AS cod,
  gl.account_name AS indicatore,
  COALESCE(
    (SELECT string_agg(ft.description,' / ' ORDER BY ic.input_sequence_num)
     FROM gl_account_input_calc ic JOIN gl_fiscal_type ft ON ft.gl_fiscal_type_id=ic.gl_fiscal_type_id
     WHERE ic.gl_account_id=gl.gl_account_id),
    CASE WHEN gl.calc_custom_method_id='SI_NO' THEN 'Si/No' ELSE gl.calc_custom_method_id END) AS formula,
  wem.kpi_score_weight AS peso,
  gl.source AS fonte,
  refpg.group_name AS referente,
  CASE WHEN gl.calc_custom_method_id='SI_NO' THEN 'SI = 100%   /   NO = 0%'
       ELSE (SELECT string_agg(
                (CASE WHEN rv.from_value<=-999999 THEN '<='||rv.thru_value
                      WHEN rv.thru_value>=999999 THEN '>='||rv.from_value
                      ELSE rv.from_value||'-'||rv.thru_value END)
                || CASE WHEN gl.calc_custom_method_id='A/B*100' THEN '%' ELSE '' END
                || ' = '||rv.range_values_factor||'%', chr(10) ORDER BY rv.range_values_factor DESC)
             FROM uom_range_values rv WHERE rv.uom_range_id=wem.uom_range_id) END AS range_verbale,
  -- Consuntivo: valori inseriti dal referente (movimenti AcctgTrans salvati dalla modale/consuntivazione).
  -- Linkage: type CTX_BS, party=scheda.org_unit_id, entry gl_account=indicatore, org=scheda.organization_id,
  -- transaction_date nel periodo della misura [wem.from_date, wem.thru_date]. Num=fattore A, Den=fattore B (PAR_*),
  -- Risultato=movimento ACTUAL, Punti=SCOREKPI (voucher_ref=misura).
  (SELECT rtrim(rtrim(to_char(SUM(ate2.amount),'FM999999999990.000000'),'0'),'.')
     FROM gl_account_input_calc ic2
     JOIN acctg_trans att2 ON att2.acctg_trans_type_id='CTX_BS' AND att2.gl_fiscal_type_id=ic2.gl_fiscal_type_id
          AND att2.party_id=we.org_unit_id AND att2.transaction_date>=wem.from_date AND att2.transaction_date<=wem.thru_date
     JOIN acctg_trans_entry ate2 ON ate2.acctg_trans_id=att2.acctg_trans_id AND ate2.gl_account_id=gl.gl_account_id
          AND ate2.organization_party_id=we.organization_id
     WHERE ic2.gl_account_id=gl.gl_account_id AND ic2.factor_calculator='A') AS numeratore,
  (SELECT rtrim(rtrim(to_char(SUM(ate2.amount),'FM999999999990.000000'),'0'),'.')
     FROM gl_account_input_calc ic2
     JOIN acctg_trans att2 ON att2.acctg_trans_type_id='CTX_BS' AND att2.gl_fiscal_type_id=ic2.gl_fiscal_type_id
          AND att2.party_id=we.org_unit_id AND att2.transaction_date>=wem.from_date AND att2.transaction_date<=wem.thru_date
     JOIN acctg_trans_entry ate2 ON ate2.acctg_trans_id=att2.acctg_trans_id AND ate2.gl_account_id=gl.gl_account_id
          AND ate2.organization_party_id=we.organization_id
     WHERE ic2.gl_account_id=gl.gl_account_id AND ic2.factor_calculator='B') AS denominatore,
  (SELECT rtrim(rtrim(to_char(ate3.amount,'FM999999999990.000000'),'0'),'.')
          || CASE WHEN gl.calc_custom_method_id='A/B*100' THEN '%' ELSE '' END
     FROM acctg_trans att3 JOIN acctg_trans_entry ate3 ON ate3.acctg_trans_id=att3.acctg_trans_id
     WHERE att3.acctg_trans_type_id='CTX_BS' AND att3.gl_fiscal_type_id='ACTUAL' AND att3.party_id=we.org_unit_id
       AND ate3.gl_account_id=gl.gl_account_id AND ate3.organization_party_id=we.organization_id
       AND att3.transaction_date>=wem.from_date AND att3.transaction_date<=wem.thru_date LIMIT 1) AS risultato,
  (SELECT ate4.amount
     FROM acctg_trans att4 JOIN acctg_trans_entry ate4 ON ate4.acctg_trans_id=att4.acctg_trans_id
     WHERE att4.acctg_trans_type_id='CTX_BS' AND ate4.gl_account_id='SCOREKPI'
       AND att4.voucher_ref=wem.work_effort_measure_id AND att4.party_id=we.org_unit_id LIMIT 1) AS punti_conseguiti
FROM work_effort_measure wem
JOIN work_effort we ON we.work_effort_id=wem.work_effort_id AND we.work_effort_type_id='CTX_BS'
JOIN gl_account gl ON gl.gl_account_id=wem.gl_account_id
LEFT JOIN gl_account_role gar ON gar.gl_account_id=gl.gl_account_id AND gar.role_type_id='WEM_IND_IN_CHARGE'
LEFT JOIN party_group refpg ON refpg.party_id=gar.party_id
WHERE wem.work_effort_id = ?
  AND (wem.is_invisible IS NULL OR wem.is_invisible <> 'Y')
  AND gl.gl_account_id NOT IN ('SCORE','SCOREKPI')  -- escludi il conto aggregato Punteggio (non e' un indicatore)
ORDER BY wem.sequence_id, gl.account_code]]></xml-property>
        </oda-data-set>
        <oda-data-set extensionID="org.eclipse.birt.report.data.oda.jdbc.JdbcSelectDataSet" name="HeaderDS" id="800">
            <list-property name="parameters">
                <structure>
                    <property name="name">workEffortId</property>
                    <property name="paramName">workEffortId</property>
                    <property name="dataType">string</property>
                    <property name="position">1</property>
                    <property name="isInput">true</property>
                    <property name="isOutput">false</property>
                </structure>
            </list-property>
            <property name="dataSource">GeneralDataSource</property>
            <list-property name="resultSet">
                <structure><property name="position">1</property><property name="name">dipartimento</property><property name="nativeName">dipartimento</property><property name="dataType">string</property></structure>
                <structure><property name="position">2</property><property name="name">uo_nome</property><property name="nativeName">uo_nome</property><property name="dataType">string</property></structure>
                <structure><property name="position">3</property><property name="name">responsabile</property><property name="nativeName">responsabile</property><property name="dataType">string</property></structure>
                <structure><property name="position">4</property><property name="name">cdc</property><property name="nativeName">cdc</property><property name="dataType">string</property></structure>
                <structure><property name="position">5</property><property name="name">anno</property><property name="nativeName">anno</property><property name="dataType">integer</property></structure>
                <structure><property name="position">6</property><property name="name">accounted_dt</property><property name="nativeName">accounted_dt</property><property name="dataType">string</property></structure>
                <structure><property name="position">7</property><property name="name">reviewed_dt</property><property name="nativeName">reviewed_dt</property><property name="dataType">string</property></structure>
            </list-property>
            <xml-property name="queryText"><![CDATA[SELECT
  dep.group_name AS dipartimento,
  uo.group_name AS uo_nome,
  COALESCE(per.first_name || ' ' || per.last_name, '') AS responsabile,
  ppr.parent_role_code AS cdc,
  EXTRACT(YEAR FROM we.estimated_completion_date)::int AS anno,
  to_char((SELECT max(ws.status_datetime) FROM work_effort_status ws
           WHERE ws.work_effort_id=we.work_effort_id AND ws.status_id='WEORCARD_ACCOUNTED'),'DD/MM/YYYY HH24:MI') AS accounted_dt,
  to_char((SELECT max(ws.status_datetime) FROM work_effort_status ws
           WHERE ws.work_effort_id=we.work_effort_id AND ws.status_id='WEORCARD_REVIEWED'),'DD/MM/YYYY HH24:MI') AS reviewed_dt
FROM work_effort we
LEFT JOIN party_group uo ON uo.party_id = we.org_unit_id
LEFT JOIN party_parent_role ppr ON ppr.party_id = we.org_unit_id AND ppr.role_type_id = 'ORGANIZATION_UNIT'
LEFT JOIN party_relationship dir ON dir.party_id_from = we.org_unit_id AND dir.role_type_id_to = 'DIRETTORE_UOC'
     AND dir.party_relationship_type_id = 'ORG_RESPONSIBLE' AND (dir.thru_date IS NULL OR dir.thru_date > now())
LEFT JOIN person per ON per.party_id = dir.party_id_to
LEFT JOIN party_relationship depr ON depr.party_id_to = we.org_unit_id AND depr.party_relationship_type_id = 'GROUP_ROLLUP'
     AND (depr.thru_date IS NULL OR depr.thru_date > now())
LEFT JOIN party_group dep ON dep.party_id = depr.party_id_from
WHERE we.work_effort_id = ?]]></xml-property>
        </oda-data-set>
    </data-sets>

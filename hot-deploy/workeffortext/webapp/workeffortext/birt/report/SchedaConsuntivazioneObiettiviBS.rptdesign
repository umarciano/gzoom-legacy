                            <data id="9915"><property name="style">anno</property><property name="textAlign">left</property><property name="resultSetColumn">annoLabel</property></data>
                        </cell>
                        <cell id="9916"><property name="textAlign">right</property><property name="verticalAlign">middle</property>
                            <image id="9917"><property name="source">file</property><property name="width">1.1in</property><expression name="uri" type="constant">hot-deploy/base/webapp/resources/images/logo-cardarelli.png</expression></image>
                        </cell>
                    </row>
                </grid>
            </page-header>
        </simple-master-page>
    </page-setup>
    <body>
        <label id="700">
            <property name="fontSize">13pt</property>
            <property name="fontWeight">bold</property>
            <property name="marginBottom">0.1in</property>
            <text-property name="text">Consuntivazione Obiettivi (Performance Strategica)</text-property>
        </label>
        <table id="500">
            <property name="width">100%</property>
            <property name="marginBottom">0.15in</property>
            <property name="dataSet">HeaderDS</property>
            <list-property name="boundDataColumns">
                <structure><property name="name">dipartimento</property><expression name="expression" type="javascript">dataSetRow["dipartimento"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">uo_nome</property><expression name="expression" type="javascript">dataSetRow["uo_nome"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">responsabile</property><expression name="expression" type="javascript">dataSetRow["responsabile"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">cdc</property><expression name="expression" type="javascript">dataSetRow["cdc"]</expression><property name="dataType">string</property></structure>
            </list-property>
            <column id="521"><property name="width">3in</property></column>
            <column id="522"><property name="width">3.5in</property></column>
            <column id="523"><property name="width">2.5in</property></column>
            <column id="524"><property name="width">1.5in</property></column>
            <header>
                <row id="530">
                    <cell id="5301"><property name="style">celhdr</property><label id="5401"><text-property name="text">Dipartimento</text-property></label></cell>
                    <cell id="5302"><property name="style">celhdr</property><label id="5402"><text-property name="text">Unità Operativa</text-property></label></cell>
                    <cell id="5303"><property name="style">celhdr</property><label id="5403"><text-property name="text">Responsabile</text-property></label></cell>

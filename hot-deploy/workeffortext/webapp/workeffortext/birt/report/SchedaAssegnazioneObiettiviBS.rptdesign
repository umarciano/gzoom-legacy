        <table id="600">
            <property name="width">100%</property>
            <property name="repeatHeader">false</property>
            <property name="dataSet">AssegnazioneDS</property>
            <list-property name="boundDataColumns">
                <structure><property name="name">cod</property><expression name="expression" type="javascript">dataSetRow["cod"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">area</property><expression name="expression" type="javascript">dataSetRow["area"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">descrizione</property><expression name="expression" type="javascript">dataSetRow["descrizione"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">indicatore</property><expression name="expression" type="javascript">dataSetRow["indicatore"]</expression><property name="dataType">string</property></structure>
                <structure><property name="name">target</property><expression name="expression" type="javascript"><![CDATA[(dataSetRow["target"]==null?"":String(dataSetRow["target"]).replace(">=","≥").replace("<=","≤"))]]></expression><property name="dataType">string</property></structure>
                <structure><property name="name">punti</property><expression name="expression" type="javascript">dataSetRow["punti"]</expression><property name="dataType">decimal</property></structure>
                <structure>
                    <property name="name">totPunti</property>
                    <property name="dataType">decimal</property>
                    <property name="aggregateFunction">SUM</property>
                    <list-property name="arguments">
                        <structure>
                            <property name="name">Expression</property>
                            <expression name="value" type="javascript">dataSetRow["punti"]</expression>
                        </structure>
                    </list-property>
                </structure>
            </list-property>
            <column id="601"><property name="width">0.7in</property></column>
            <column id="602"><property name="width">1.3in</property></column>
            <column id="603"><property name="width">2.7in</property></column>
            <column id="604"><property name="width">2.7in</property></column>
            <column id="605"><property name="width">1.2in</property></column>
            <column id="606"><property name="width">0.8in</property></column>
            <header>
                <row id="620">
                    <cell id="6201"><property name="style">celhdr</property><label id="6301"><text-property name="text">Cod.</text-property></label></cell>
                    <cell id="6202"><property name="style">celhdr</property><label id="6302"><text-property name="text">Area</text-property></label></cell>
                    <cell id="6203"><property name="style">celhdr</property><label id="6303"><text-property name="text">Descrizione</text-property></label></cell>
                    <cell id="6204"><property name="style">celhdr</property><label id="6304"><text-property name="text">Indicatore</text-property></label></cell>
                    <cell id="6205"><property name="style">celhdr</property><label id="6305"><text-property name="text">Target</text-property></label></cell>
                    <cell id="6206"><property name="style">celhdr</property><label id="6306"><text-property name="text">Punti</text-property></label></cell>
                </row>
            </header>
            <detail>
                <row id="640">
                    <cell id="6401"><property name="style">celbrd</property><data id="6501"><property name="resultSetColumn">cod</property></data></cell>
                    <cell id="6402"><property name="style">celbrd</property><data id="6502"><property name="resultSetColumn">area</property></data></cell>
                    <cell id="6403"><property name="style">celbrd</property><data id="6503"><property name="resultSetColumn">descrizione</property></data></cell>
                    <cell id="6404"><property name="style">celbrd</property><data id="6504"><property name="resultSetColumn">indicatore</property></data></cell>
                    <cell id="6405"><property name="style">celbrd</property><data id="6505"><property name="style">numc</property><property name="resultSetColumn">target</property></data></cell>
                    <cell id="6406"><property name="style">celbrd</property><data id="6506"><property name="style">numc</property><property name="resultSetColumn">punti</property></data></cell>
                </row>
            </detail>

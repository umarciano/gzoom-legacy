    <page-setup>
        <simple-master-page name="MasterPage" id="990">
            <property name="type">a4</property>
            <property name="orientation">landscape</property>
            <property name="topMargin">0.3in</property>
            <property name="bottomMargin">0.4in</property>
            <property name="leftMargin">0.5in</property>
            <property name="rightMargin">0.5in</property>
            <property name="headerHeight">0.7in</property>
            <property name="footerHeight">1in</property>
            <page-header>
                <grid id="9910">
                    <property name="width">100%</property>
                    <property name="dataSet">HeaderDS</property>
                    <list-property name="boundDataColumns">
                        <structure><property name="name">annoLabel</property><expression name="expression" type="javascript">"Ciclo Performance anno " + (dataSetRow["anno"]==null?"":dataSetRow["anno"])</expression><property name="dataType">string</property></structure>
                    </list-property>
                    <column id="9911"><property name="width">78%</property></column>
                    <column id="9912"><property name="width">22%</property></column>
                    <row id="9913">
                        <cell id="9914"><property name="verticalAlign">middle</property>
                            <data id="9915"><property name="style">anno</property><property name="textAlign">left</property><property name="resultSetColumn">annoLabel</property></data>
                        </cell>
                        <cell id="9916"><property name="textAlign">right</property><property name="verticalAlign">middle</property>
                            <image id="9917"><property name="source">file</property><property name="width">1.1in</property><expression name="uri" type="constant">hot-deploy/base/webapp/resources/images/logo-cardarelli.png</expression></image>
                        </cell>
                    </row>
                </grid>
            </page-header>
            <page-footer>
                <grid id="9920">
                    <property name="width">100%</property>
                    <property name="dataSet">HeaderDS</property>
                    <list-property name="boundDataColumns">
                        <structure><property name="name">firmaSanAmm</property><expression name="expression" type="javascript"><![CDATA[(dataSetRow["validated_dt"]==null?"":"F.to Direttore Sanitario/Amministrativo\n"+dataSetRow["validated_dt"])]]></expression><property name="dataType">string</property></structure>
                        <structure><property name="name">firmaUO</property><expression name="expression" type="javascript"><![CDATA[(dataSetRow["valpart_dt"]==null?"":"F.to Direttore UO\n"+dataSetRow["valpart_dt"])]]></expression><property name="dataType">string</property></structure>
                    </list-property>
                    <column id="9921"><property name="width">50%</property></column>
                    <column id="9922"><property name="width">50%</property></column>

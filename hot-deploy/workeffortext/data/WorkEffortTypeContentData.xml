    <!-- Parametri BeanShell per il calcolo punteggio di CTX_OR (Performance Organizzativa)    -->
    <!-- Letti da WorkEffortTypeCntParamsEvaluator quando contentId='WEFLD_ELAB'               -->
    <!-- BUDGET = soglia 75% (target hardcoded nel converter), SOGLIA_50/SOGLIA_100 = estremi   -->
    <!-- Usati da ElaboreteScoreIndicServices per passare i glFiscalTypeId a KpiReader          -->
    <WorkEffortTypeContent workEffortTypeId="CTX_OR" weTypeContentTypeId="WEFLD_ELAB" contentId="WEFLD_ELAB"
        params="glFiscalTypeIdExcellentLimit = &quot;SOGLIA_100&quot;; glFiscalTypeIdUpperLimit = &quot;SOGLIA_100&quot;; glFiscalTypeIdLowerLimit = &quot;SOGLIA_50&quot;;"/>
</entity-engine-xml>
